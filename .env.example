# Application
APP_NAME=aionn-modulith-backend
SERVER_PORT=8080
FLYWAY_ENABLED=true
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_LOCAL_PORT=5434
POSTGRES_DB=aionn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres

# Redis
REDIS_HOST=localhost
REDIS_LOCAL_PORT=6379
REDIS_PASSWORD=change-me-local-redis

# OpenSearch
OPENSEARCH_LOCAL_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-local-opensearch-admin
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
CATALOG_SEARCH_PROVIDER=opensearch
CATALOG_SEARCH_OPENSEARCH_HOST=localhost
CATALOG_SEARCH_OPENSEARCH_PORT=9200
CATALOG_SEARCH_OPENSEARCH_SCHEME=http
CATALOG_SEARCH_OPENSEARCH_USERNAME=
CATALOG_SEARCH_OPENSEARCH_PASSWORD=

# Local identity providers
IDENTITY_JWT_SECRET=local-development-jwt-secret-change-me-32-chars
IDENTITY_MFA_ENCRYPTION_KEY=local-development-mfa-key-change-me
CAPTCHA_PROVIDER=mock
CAPTCHA_EXPECTED_TOKEN=local-captcha-token
IDENTITY_AUTH_GOOGLE_PROVIDER=local
IDENTITY_AUTH_GOOGLE_CLIENT_ID=
IDENTITY_KYC_PROVIDER=local
IDENTITY_MEDIA_PROVIDER=mock

# Shared media credentials. Replace these values to exercise Cloudinary adapters.
CLOUDINARY_CLOUD_NAME=local-cloud
CLOUDINARY_API_KEY=local-key
CLOUDINARY_API_SECRET=local-secret
CATALOG_MEDIA_PROVIDER=cloudinary
CHAT_MEDIA_PROVIDER=cloudinary
PROMOTION_MEDIA_PROVIDER=cloudinary

# Local payment providers. Credentials are placeholders, not usable sandbox keys.
STRIPE_ENABLED=true
STRIPE_API_KEY=replace-with-stripe-sandbox-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
VNPAY_ENABLED=true
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:3000/payments/return
PAYMENT_AUTO_PAYOUT_ENABLED=false

# GHN sandbox. Leave the poller disabled until valid sandbox credentials are set.
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
GHN_SERVICE_ID=
GHN_WEBHOOK_SECRET=
SHIPPING_STATUS_POLLER_ENABLED=false

# Local notification providers
NOTIFICATION_EMAIL_PROVIDER=logging
NOTIFICATION_SMS_PROVIDER=logging
NOTIFICATION_PUSH_PROVIDER=logging
NOTIFICATION_SMTP_HOST=localhost
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_EMAIL_FROM=no-reply@aionn.local

# Browser clients
CHAT_WS_ALLOWED_ORIGINS=http://localhost:3000

# Application scheduler pool. Business @Scheduled jobs run here; the outbox dispatcher keeps its own
# single thread. Keep at or above the number of scheduled jobs that do not name a scheduler.
SCHEDULER_POOL_SIZE=20

# Recommendation. No credentials and no external provider: these are tuning knobs only, and every one
# has the same default inline in application-recommendation.yml. Full notes in envs/recommendation.env.
RECOMMENDATION_WEIGHT_VIEW_BASE=1.0
RECOMMENDATION_WEIGHT_VIEW_HALF_LIFE_DAYS=14
RECOMMENDATION_WEIGHT_CART_ADD_BASE=4.0
RECOMMENDATION_WEIGHT_CART_ADD_HALF_LIFE_DAYS=30
RECOMMENDATION_WEIGHT_PURCHASE_BASE=5.0
RECOMMENDATION_WEIGHT_PURCHASE_HALF_LIFE_DAYS=180
RECOMMENDATION_RANKING_COLLABORATIVE_WEIGHT=0.50
RECOMMENDATION_RANKING_CONTENT_WEIGHT=0.35
RECOMMENDATION_RANKING_POPULARITY_WEIGHT=0.15
RECOMMENDATION_RANKING_CATEGORY_AFFINITY_WEIGHT=0.45
RECOMMENDATION_RANKING_BRAND_AFFINITY_WEIGHT=0.35
RECOMMENDATION_RANKING_PRICE_FIT_WEIGHT=0.20
RECOMMENDATION_RANKING_CANDIDATE_OVER_FETCH_FACTOR=3
RECOMMENDATION_RANKING_MAX_CANDIDATES=200
RECOMMENDATION_COLD_START_CONTENT_ONLY_THRESHOLD=1
RECOMMENDATION_COLD_START_FULL_HYBRID_THRESHOLD=5
RECOMMENDATION_PROFILE_MAX_AFFINITIES=10
RECOMMENDATION_PROFILE_LOOKBACK_DAYS=180
RECOMMENDATION_SIMILARITY_LOOKBACK_DAYS=180
RECOMMENDATION_SIMILARITY_MIN_CO_OCCURRENCE=2
RECOMMENDATION_SIMILARITY_MAX_NEIGHBOURS_PER_PRODUCT=50
RECOMMENDATION_POPULARITY_LOOKBACK_DAYS=30
RECOMMENDATION_RETENTION_INTERACTION_MAX_AGE_DAYS=180
# Must stay below the PT30M ShedLock held by the similarity and popularity rebuilds.
RECOMMENDATION_EXECUTION_COMPUTE_TIMEOUT_SECONDS=900
RECOMMENDATION_EXECUTION_UPSERT_BATCH_SIZE=500
RECOMMENDATION_SCHEDULING_PROFILE_REFRESH_ENABLED=true
RECOMMENDATION_SCHEDULING_PROFILE_REFRESH_DELAY_MS=900000
RECOMMENDATION_SCHEDULING_PROFILE_REFRESH_BATCH_SIZE=500
RECOMMENDATION_SCHEDULING_ITEM_SIMILARITY_ENABLED=true
RECOMMENDATION_SCHEDULING_ITEM_SIMILARITY_DELAY_MS=3600000
RECOMMENDATION_SCHEDULING_POPULARITY_ENABLED=true
RECOMMENDATION_SCHEDULING_POPULARITY_DELAY_MS=900000
RECOMMENDATION_SCHEDULING_PRUNE_ENABLED=true
RECOMMENDATION_SCHEDULING_PRUNE_DELAY_MS=86400000
RECOMMENDATION_SCHEDULING_PRUNE_BATCH_SIZE=1000
RECOMMENDATION_CACHE_HOME_L1_TTL_SECONDS=60
RECOMMENDATION_CACHE_HOME_L1_MAX_SIZE=1000
RECOMMENDATION_CACHE_HOME_L2_TTL_SECONDS=900
RECOMMENDATION_CACHE_SIMILAR_L1_TTL_SECONDS=300
RECOMMENDATION_CACHE_SIMILAR_L1_MAX_SIZE=2000
RECOMMENDATION_CACHE_SIMILAR_L2_TTL_SECONDS=3600
RECOMMENDATION_CACHE_TRENDING_L1_TTL_SECONDS=60
RECOMMENDATION_CACHE_TRENDING_L1_MAX_SIZE=10
RECOMMENDATION_CACHE_TRENDING_L2_TTL_SECONDS=900
